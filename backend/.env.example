DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/chnt
SECRET_KEY=replace-with-a-random-secret-before-running
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
ADMIN_EMAIL=adminhdk@gmail.com
ADMIN_PASSWORD=change-this-admin-password

# --- Quên mật khẩu qua email (tùy chọn) ---
# Địa chỉ giao diện web, dùng để tạo liên kết trong email
FRONTEND_URL=http://localhost:5175
# Để trống SMTP_HOST thì liên kết đặt lại mật khẩu chỉ được ghi ra log backend (dùng khi phát triển)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ người gửi, mặc định lấy SMTP_USER
SMTP_FROM=
# true nếu dùng cổng SSL 465, false nếu dùng STARTTLS cổng 587
SMTP_USE_SSL=false
# Hiệu lực của liên kết (phút)
RESET_TOKEN_MINUTES=30
# Email nhận thông báo khi có đơn hàng mới (mặc định là ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=
